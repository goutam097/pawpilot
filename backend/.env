# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Comma-separated list of origins allowed to make browser requests (CORS).
# Include Expo dev ports plus the machine's LAN IP for device/emulator access.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://192.168.1.14:8081,http://192.168.1.14:19006

# MongoDB connection string. Include the database name before the query string.
MONGODB_URI=mongodb://localhost:27017/pawpilot

# Secrets for signing tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# They MUST be different from each other. Rotating them invalidates all sessions.
JWT_ACCESS_SECRET=sadsdNHASHYUGS&4346sdasDFDFSFDSFSDFSD
JWT_REFRESH_SECRET=SDAKJDHHHHhsbsahsay87878csaASHhs

# Token lifetimes (accepts ms-style strings: 15m, 7d, 30d, etc.)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# p-6 will start